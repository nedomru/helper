{
  "manifest_version": 3,
  "name": "Хелпер",
  "version": "3.0",
  "description": "Инструмент для помощи в работе",
  "options_ui": {
    "page": "src/pages/options/index.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "src/pages/popup/index.html",
    "default_icon": {
      "32": "icon-32.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "src/pages/newtab/index.html"
  },
  "icons": {
    "128": "icon-128.png"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "management",
    "activeTab",
    "contextMenus",
    "browsingData"
  ],
  "host_permissions": [
    "*://*.ertelecom.ru/*",
    "https://helper.chrsnv.ru/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.ertelecom.ru/*"
      ],
      "js": [
        "src/pages/content/arm/init.ts",
        "src/pages/content/genesys/init.ts",
        "src/pages/content/line/init.ts"
      ],
      "css": [
        "contentStyle.css"
      ],
      "all_frames": true
    }
  ],
  "devtools_page": "src/pages/devtools/index.html",
  "web_accessible_resources": [
    {
      "resources": [
        "contentStyle.css",
        "icon-128.png",
        "icon-32.png",
        "sounds/*.mp3"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
