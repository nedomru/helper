{
  "manifest_version": 3,
  "name": "Хелпер",
  "version": "3.0",
  "description": "Твой швейцарский нож для работы \uD83D\uDE0E",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-hashes'; object-src 'self'; connect-src 'self' http://octptest.corp.ertelecom.loc https://okc.ertelecom.ru https://helper.chrsnv.ru https://api.macvendors.com "
  },
  "options_ui": {
    "page": "src/pages/options/index.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "src/pages/popup/index.html",
    "default_icon": {
      "32": "icon-32.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "src/pages/newtab/index.html"
  },
  "icons": {
    "128": "icon-128.png"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "management",
    "activeTab",
    "contextMenus",
    "browsingData",
    "cookies"
  ],
  "host_permissions": [
    "*://*.ertelecom.ru/*",
    "*://*.ertelecom.loc/*",
    "https://helper.chrsnv.ru/*",
    "https://api.macvendors.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.ertelecom.ru/*"
      ],
      "js": [
        "src/pages/content/arm/init.ts",
        "src/pages/content/genesys/init.ts",
        "src/pages/content/line/init.ts"
      ],
      "css": [
        "contentStyle.css"
      ],
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/pages/content/speech-phrases/index.ts"
      ],
      "all_frames": true,
      "exclude_matches": [
        "*://*/*options*"
      ]
    }
  ],
  "devtools_page": "src/pages/devtools/index.html",
  "web_accessible_resources": [
    {
      "resources": [
        "contentStyle.css",
        "icon-128.png",
        "icon-32.png",
        "sounds/*.mp3"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "author": "Roman Chursanov"
}
