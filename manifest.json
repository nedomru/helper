{
  "manifest_version": 3,
  "name": "Хелпер",
  "version": "3.1.0.0",
  "description": "Твой швейцарский нож для работы \uD83D\uDE0E",
  "options_ui": {
    "page": "src/pages/options/index.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "src/pages/popup/index.html",
    "default_icon": {
      "32": "icon-32.png"
    }
  },
  "icons": {
    "128": "icon-128.png"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "management",
    "contextMenus",
    "browsingData",
    "cookies"
  ],
  "host_permissions": [
    "*://*.ertelecom.ru/*",
    "*://*.ertelecom.loc/*",
    "https://helper.chrsnv.ru/*",
    "https://api.macvendors.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://genesys-app1.cc1.ertelecom.ru/*",
        "*://genesys-app1.cc4.ertelecom.ru/*"
      ],
      "js": [
        "src/pages/content/genesys/init.ts"
      ],
      "all_frames": true
    },
    {
      "matches": [
        "*://*.db.ertelecom.ru/*"
      ],
      "js": [
        "src/pages/content/arm/init.ts"
      ],
      "all_frames": true
    },
    {
      "matches": [
        "*://okc.ertelecom.ru/*"
      ],
      "js": [
        "src/pages/content/line/init.ts"
      ],
      "all_frames": true
    },
    {
      "matches": [
        "*://scripting-app.ertelecom.ru/*",
        "*://okc.ertelecom.ru/*",
        "*://*.db.ertelecom.ru/*",
        "*://genesys-app1.cc1.ertelecom.ru/*",
        "*://genesys-app1.cc4.ertelecom.ru/*"
      ],
      "js": [
        "src/pages/content/speech-phrases/index.ts"
      ],
      "all_frames": true
    }
  ],
  "devtools_page": "src/pages/devtools/index.html",
  "web_accessible_resources": [
    {
      "resources": [
        "contentStyle.css",
        "icon-128.png",
        "icon-32.png",
        "sounds/*.mp3",
        "src/pages/speech-phrases/*",
        "assets/speech-phrases*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http: https:"
  },
  "author": "Roman Chursanov"
}
