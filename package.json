{
  "name": "helper-ext",
  "version": "3.0.0.3",
  "description": "Инструмент для помощи в работе",
  "license": "MIT",
  "scripts": {
    "build": "vite build --config vite.config.chrome.ts",
    "build:chrome": "vite build --config vite.config.chrome.ts",
    "build:firefox": "vite build --config vite.config.firefox.ts",
    "dev": "nodemon --config nodemon.chrome.json",
    "dev:chrome": "nodemon --config nodemon.chrome.json",
    "dev:firefox": "nodemon --config nodemon.firefox.json",
    "format": "biome format --write",
    "check": "biome check --write",
    "lint": "biome lint --write",
    "sign:firefox": "dotenv -e .env -- sh -c 'web-ext sign --api-key=$AMO_JWT_ISSUER --api-secret=$AMO_JWT_SECRET --source-dir=dist_firefox --channel=unlisted'",
    "lint:firefox": "web-ext lint --source-dir=dist_firefox"
  },
  "type": "module",
  "dependencies": {
    "biome": "^0.3.3",
    "dotenv-cli": "^11.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "web-ext": "^9.4.0",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.4.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/chrome": "^0.1.42",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/webextension-polyfill": "^0.12.5",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fs-extra": "^11.3.5",
    "nodemon": "^3.1.14",
    "tailwindcss": "^4.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "7.3.1",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
